DATABASE_URL="mysql://root:@localhost:3306/ruangku_db"
PORT=3000
JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
JWT_EXPIRES_IN="1d"
NODE_ENV="development"
TRUST_PROXY=0

# CORS_ORIGIN wajib diisi saat NODE_ENV=production. Daftar origin dipisah koma.
CORS_ORIGIN="http://localhost:5173"
# Konfigurasi SMTP opsional. Tanpa SMTP, tautan reset dicetak ke log hanya pada development.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="RuangKu <no-reply@example.com>"
# APP_WEB_URL="http://localhost:5173"
# UPLOAD_DIR="uploads"                     # folder foto ruangan (default: ./uploads)
# REMINDER_LEAD_MINUTES=60                 # pengingat dikirim X menit sebelum peminjaman dimulai
# BOOKING_MIN_MINUTES=30                   # durasi minimal peminjaman
# BOOKING_MAX_HOURS=8                      # durasi maksimal peminjaman
# BOOKING_MAX_DAYS_AHEAD=90                # batas hari ke depan untuk booking

# Seed: admin hanya dibuat bila kedua variabel berikut diisi.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO=false
# Wajib diisi saat SEED_DEMO=true.
SEED_DEMO_STUDENT_PASSWORD=
SEED_DEMO_LECTURER_PASSWORD=
SEED_DEMO_LEADERSHIP_PASSWORD=
